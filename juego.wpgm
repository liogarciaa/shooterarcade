import wollok.game.*
import jugador.*
import partida.*

program juego {

    game.width(partida.arena().ancho())
    game.height(partida.arena().alto())
    
    game.cellSize(50)

    game.title("Shooter")
	
	const jugadorPrincipal = partida.jugadores().first()
		
    game.addVisual(jugadorPrincipal)

    game.start()
}
